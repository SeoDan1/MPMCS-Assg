; ==============================================================================
; UTAR Microprocessor & Microcontroller System (UGEA2633)
; Topic 1: Calculator (Input & Computing)
; Target IDE: MCU8051IDE
; ==============================================================================

ORG 0000H
    SJMP MAIN               ; Jump to main initialization

; --- Initialization ---
MAIN:
    MOV P1, #0FFH           ; Configure Port 1 as input for Keypad
    MOV R2, #00H            ; Clear Op1 High Byte
    MOV R3, #00H            ; Clear Op1 Low Byte
    MOV R4, #00H            ; Clear Op2 High Byte
    MOV R5, #00H            ; Clear Op2 Low Byte
    CLR 20H.0               ; Clear Error Flag

; --- Main Superloop ---
CALC_LOOP:
    ACALL KEYPAD_SCAN       ; Scan 4x4 keypad for input
    ; (Decoding logic to determine if key is number or operator goes here)
    ; For demonstration, assuming operator jump table based on key pressed:
    ; ACALL DO_ADD
    ; ACALL DO_DIV
    ; ACALL DO_AND
    ; ACALL DO_SQUARE
    SJMP CALC_LOOP          ; Loop infinitely

; ==============================================================================
; 1. INPUT: 4x4 Keypad Scanning & Debouncing
; ==============================================================================
KEYPAD_SCAN:
    MOV P1, #0F0H           ; Set Columns (P1.4-P1.7) high, Rows (P1.0-P1.3) low
    MOV A, P1               ; Read Port 1
    CJNE A, #0F0H, KEY_PRESS_DETECTED
    RET                     ; No key pressed, return

KEY_PRESS_DETECTED:
    ACALL DEBOUNCE_DELAY    ; 20ms debounce delay
    MOV A, P1               ; Read again to verify
    CJNE A, #0F0H, DECODE_KEY
    RET                     ; False trigger

DECODE_KEY:
    ; Matrix row-grounding logic to pinpoint exact key
    ; Example for Row 0:
    MOV P1, #0FEH           ; Ground Row 0 (P1.0 = 0)
    MOV A, P1
    JNB ACC.4, KEY_0_PRESSED; If Col 0 is low, Key [0,0] is pressed
    JNB ACC.5, KEY_1_PRESSED; If Col 1 is low, Key [0,1] is pressed
    ; ... (Repeat for all rows and columns)
    RET

KEY_0_PRESSED:
    MOV A, #00H             ; Load value of key pressed
    RET
KEY_1_PRESSED:
    MOV A, #01H
    RET

; ==============================================================================
; 2. BASIC MATH: 16-Bit Arithmetic Operations
; ==============================================================================
DO_ADD:
    ; 16-bit Addition: Op1 (R2, R3) + Op2 (R4, R5)
    MOV A, R3               ; Load Op1 Low Byte
    ADD A, R5               ; Add Op2 Low Byte
    MOV R3, A               ; Store result Low Byte
    
    MOV A, R2               ; Load Op1 High Byte
    ADDC A, R4              ; Add Op2 High Byte + Carry
    MOV R2, A               ; Store result High Byte
    
    JC OVERFLOW_ERROR       ; Check for 16-bit overflow
    RET

DO_DIV:
    ; 8-bit Division (Uses Accumulator and B register)
    MOV A, R3               ; Load Op1 into A
    MOV B, R5               ; Load Op2 into B
    
    MOV A, B                ; Pre-check denominator
    JZ DIV_ZERO_ERROR       ; Jump to error if dividing by 0
    
    MOV A, R3               ; Restore Op1
    DIV AB                  ; Divide A by B
    ; Result: Quotient in A, Remainder in B
    RET

; ==============================================================================
; 3. BASIC MATH: 8-Bit Logical Operations
; ==============================================================================
DO_AND:
    MOV A, R3               ; Load Op1
    ANL A, R5               ; Logical AND with Op2
    MOV R3, A               ; Store Result
    RET

DO_OR:
    MOV A, R3               ; Load Op1
    ORL A, R5               ; Logical OR with Op2
    MOV R3, A               ; Store Result
    RET

DO_XOR:
    MOV A, R3               ; Load Op1
    XRL A, R5               ; Logical XOR with Op2
    MOV R3, A               ; Store Result
    RET

; ==============================================================================
; 4. ADDITIONAL FUNCTION 1: Square (x^2)
; ==============================================================================
DO_SQUARE:
    ; Copies user input into A and B, yielding a 16-bit product
    MOV A, R3               ; Load operand (assume 8-bit input for square)
    MOV B, A                ; Copy to B
    MUL AB                  ; Multiply A * B
    
    MOV R3, A               ; Store Low Byte of product
    MOV R2, B               ; Store High Byte of product
    RET

; ==============================================================================
; 5. ADDITIONAL FUNCTION 2: Error Detection & Handling
; ==============================================================================
DIV_ZERO_ERROR:
    ; Triggered if divisor is 0
    SETB 20H.0              ; Set internal error flag
    MOV A, #0EEH            ; Load 'E' / Error code to send to display
    ; ACALL SEND_TO_DISPLAY
    RET

OVERFLOW_ERROR:
    ; Triggered if result exceeds 16 bits (65,535)
    SETB 20H.0              ; Set internal error flag
    MOV A, #0EEH            ; Load 'E' / Error code to send to display
    ; ACALL SEND_TO_DISPLAY
    RET

; ==============================================================================
; UTILITIES: Delays
; ==============================================================================
DEBOUNCE_DELAY:
    ; Approx 20ms delay for mechanical switch debouncing
    MOV R6, #40
D1: MOV R7, #250
    DJNZ R7, $
    DJNZ R6, D1
    RET

END
