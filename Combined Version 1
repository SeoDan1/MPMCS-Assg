; ==============================================================================
; UTAR Microprocessor & Microcontroller System (UGEA2633)
; Topic 1: Calculator (Input, Computing & Instant LCD Display)
; Hardware: 4x4 Keypad on Port 1 | 16x2 LCD on Port 3 (Data) & Port 2 (Ctrl)
; Target IDE: MCU8051IDE (Port 3 drives LCD directly without external pull-ups)
; ==============================================================================

    ORG 0000H
    LJMP MAIN               ; Jump to initialization

; ==============================================================================
; BIT & REGISTER ASSIGNMENTS
; ==============================================================================
; P2.0 = RS, P2.1 = RW, P2.2 = EN
; P3.0 - P3.7 = LCD Data Bus (D0 - D7)
; 20H.0 = ERR_FLAG, 20H.1 = SHIFT_FLAG
; R2:R3 = Op1, R4:R5 = Op2
; R6 = Operator, R7 = State Flag (0=Op1, 1=Op2)
; ==============================================================================

MAIN:
    ; 1. Configure Port 1 Columns as Inputs (P1.4-P1.7 = 1)
    MOV P1, #0FFH           
    
    ; 2. Initialize LCD
    LCALL LCD_INIT
    
    ; 3. Clear System & LCD Screen
    CLR 20H.0               
    CLR 20H.1               
    LCALL CLEAR_ALL         

; ==============================================================================
; MAIN CALCULATOR LOOP
; ==============================================================================
CALC_LOOP:
    LCALL KEYPAD_SCAN       ; Read keypress
    CJNE A, #0FFH, PROCESS_KEY 
    LJMP CALC_LOOP          ; Keeps scanning

PROCESS_KEY:
    PUSH ACC                ; Save raw key code
    LCALL WAIT_KEY_RELEASE  
    POP ACC                 ; Restore key code

    ; Check for Shift Toggle Key ('D' / Key Code 0DH)
    CJNE A, #0DH, CHECK_DIGIT
    CPL 20H.1               ; Toggle Shift Mode Flag
    LJMP CALC_LOOP

CHECK_DIGIT:
    ; If Key is 0..9, process numeric input and print to LCD
    CJNE A, #0AH, $ + 3
    JNC CHECK_OPERATOR      ; If A >= 10, jump to operator handler
    
    ; --- PRINT DIGIT TO LCD ---
    PUSH ACC                ; Save raw numeric value (0-9)
    ADD A, #30H             ; Convert to ASCII ('0'-'9')
    LCALL LCD_DATA          ; Print to screen
    POP ACC                 ; Restore raw numeric value
    
    ; --- STORE IN REGISTER ---
    LCALL ACCUMULATE_DIGIT  
    LJMP CALC_LOOP

CHECK_OPERATOR:
    ; Key A (0AH): Addition (+) OR Logical AND (&)
    CJNE A, #0AH, TRY_B
    JB 20H.1, SET_AND
    MOV R6, #01H            ; ADD
    MOV A, #'+'             ; Print '+'
    LCALL LCD_DATA
    SJMP NEXT_OPERAND
SET_AND:
    MOV R6, #05H            ; AND
    MOV A, #'&'             ; Print '&'
    LCALL LCD_DATA
    SJMP NEXT_OPERAND

TRY_B:
    ; Key B (0BH): Subtraction (-) OR Logical OR (|)
    CJNE A, #0BH, TRY_C
    JB 20H.1, SET_OR
    MOV R6, #02H            ; SUB
    MOV A, #'-'             ; Print '-'
    LCALL LCD_DATA
    SJMP NEXT_OPERAND
SET_OR:
    MOV R6, #06H            ; OR
    MOV A, #'|'             ; Print '|'
    LCALL LCD_DATA
    SJMP NEXT_OPERAND

TRY_C:
    ; Key C (0CH): Multiplication (*) OR Logical XOR (^)
    CJNE A, #0CH, TRY_HASH
    JB 20H.1, SET_XOR
    MOV R6, #03H            ; MUL
    MOV A, #'*'             ; Print '*'
    LCALL LCD_DATA
    SJMP NEXT_OPERAND
SET_XOR:
    MOV R6, #07H            ; XOR
    MOV A, #'^'             ; Print '^'
    LCALL LCD_DATA
    SJMP NEXT_OPERAND

TRY_HASH:
    ; Key # (0FH): Division (/) OR Square Function (x^2)
    CJNE A, #0FH, TRY_STAR
    JB 20H.1, DO_SQUARE
    MOV R6, #04H            ; DIV
    MOV A, #'/'             ; Print '/'
    LCALL LCD_DATA
    SJMP NEXT_OPERAND
DO_SQUARE:
    MOV R6, #08H            ; Square
    MOV A, #'2'             ; Print '2' (indicator)
    LCALL LCD_DATA
    LCALL EXECUTE_MATH      
    LJMP CALC_LOOP          

TRY_STAR:
    ; Key * (0EH): Equals (=) OR Clear (Shift + =)
    CJNE A, #0EH, NEXT_OPERAND
    JB 20H.1, DO_CLEAR      ; If Shift flag is 1, do CLEAR
    
    ; DO EQUALS
    MOV A, #'='             ; Print '='
    LCALL LCD_DATA
    LCALL EXECUTE_MATH      ; Run calculation
    LJMP CALC_LOOP          

DO_CLEAR:
    CLR 20H.0               ; Reset Error Flag
    CLR 20H.1               ; Reset Shift Flag
    LCALL CLEAR_ALL         ; Clears registers AND the LCD
    LJMP CALC_LOOP          

NEXT_OPERAND:
    MOV R7, #01H            ; Switch state to enter Op2
    LJMP CALC_LOOP          

; ==============================================================================
; UTILITY: CLEAR REGISTERS AND LCD
; ==============================================================================
CLEAR_ALL:
    MOV R2, #00H            ; Clear Op1 High
    MOV R3, #00H            ; Clear Op1 Low
    MOV R4, #00H            ; Clear Op2 High
    MOV R5, #00H            ; Clear Op2 Low
    MOV R6, #00H            ; Clear Operator
    MOV R7, #00H            ; Reset State Machine to Op1
    MOV A, #01H             ; Command: Clear LCD Display
    LCALL LCD_CMD
    LCALL LONG_DELAY
    MOV A, #80H             ; Command: Set DDRAM Address to 00
    LCALL LCD_CMD
    RET

; ==============================================================================
; LCD DRIVER ROUTINES (ATOMIC P2 PULSING FOR MCU8051IDE VIRTUAL HARDWARE)
; ==============================================================================
LCD_INIT:
    LCALL POWER_ON_DELAY    
    
    MOV A, #00111000B       ; 8-bit mode, 2 lines, 5x7 font
    LCALL LCD_CMD
    
    MOV A, #00001100B       ; Display ON, Cursor OFF
    LCALL LCD_CMD
    
    MOV A, #00000110B       ; Auto-increment cursor
    LCALL LCD_CMD
    
    MOV A, #00000001B       ; Clear Display
    LCALL LCD_CMD
    LCALL LONG_DELAY        
    
    MOV A, #10000000B       ; Command 80H: Force Cursor to Line 1, Pos 1
    LCALL LCD_CMD
    RET

LCD_CMD:
    MOV P3, A               ; Put command byte on Port 3
    MOV P2, #0F4H           ; RS=0, RW=0, EN=1 (1111 0100b) -> Pulse HIGH
    LCALL SHORT_DELAY       ; Hold pulse
    MOV P2, #0F0H           ; RS=0, RW=0, EN=0 (1111 0000b) -> Falling Edge
    LCALL LCD_DELAY         
    RET

LCD_DATA:
    MOV P3, A               ; Put ASCII data byte on Port 3
    MOV P2, #0F5H           ; RS=1, RW=0, EN=1 (1111 0101b) -> Pulse HIGH
    LCALL SHORT_DELAY       ; Hold pulse
    MOV P2, #0F1H           ; RS=1, RW=0, EN=0 (1111 0001b) -> Falling Edge
    LCALL LCD_DELAY         
    RET

; Delay loops to ensure GUI thread captures state transitions
SHORT_DELAY:
    PUSH 00H
    MOV R0, #30
    DJNZ R0, $
    POP 00H
    RET

LCD_DELAY:
    PUSH 00H
    MOV R0, #50
    DJNZ R0, $
    POP 00H
    RET

POWER_ON_DELAY:
LONG_DELAY:
    PUSH 00H
    MOV R0, #100
    DJNZ R0, $
    POP 00H
    RET

; Instant Keypad Debounce Delay
DEBOUNCE_DELAY:
    MOV R0, #1
D_LOOP1:
    MOV R1, #1
D_LOOP2:
    DJNZ R1, D_LOOP2
    DJNZ R0, D_LOOP1
    RET

; ==============================================================================
; KEYPAD SCANNING ROUTINE (WITH NIBBLE MASKING)
; ==============================================================================
KEYPAD_SCAN:
    MOV P1, #0F0H           
    MOV A, P1
    ANL A, #0F0H            
    CJNE A, #0F0H, KEY_FOUND
    MOV A, #0FFH            
    RET

KEY_FOUND:
    LCALL DEBOUNCE_DELAY    
    MOV P1, #0F0H
    MOV A, P1
    ANL A, #0F0H
    CJNE A, #0F0H, SCAN_ROW_0
    MOV A, #0FFH            
    RET

SCAN_ROW_0:
    MOV P1, #0FEH           ; Row 0
    MOV A, P1
    JNB ACC.4, GOT_KEY_1
    JNB ACC.5, GOT_KEY_2
    JNB ACC.6, GOT_KEY_3
    JNB ACC.7, GOT_KEY_A

SCAN_ROW_1:
    MOV P1, #0FDH           ; Row 1
    MOV A, P1
    JNB ACC.4, GOT_KEY_4
    JNB ACC.5, GOT_KEY_5
    JNB ACC.6, GOT_KEY_6
    JNB ACC.7, GOT_KEY_B

SCAN_ROW_2:
    MOV P1, #0FBH           ; Row 2
    MOV A, P1
    JNB ACC.4, GOT_KEY_7
    JNB ACC.5, GOT_KEY_8
    JNB ACC.6, GOT_KEY_9
    JNB ACC.7, GOT_KEY_C

SCAN_ROW_3:
    MOV P1, #0F7H           ; Row 3
    MOV A, P1
    JNB ACC.4, GOT_KEY_STAR
    JNB ACC.5, GOT_KEY_0
    JNB ACC.6, GOT_KEY_HASH
    JNB ACC.7, GOT_KEY_D

    MOV A, #0FFH            
    RET

; --- Key Return Mapping ---
GOT_KEY_0: MOV A, #00H
 RET
GOT_KEY_1: MOV A, #01H
 RET
GOT_KEY_2: MOV A, #02H
 RET
GOT_KEY_3: MOV A, #03H
 RET
GOT_KEY_4: MOV A, #04H
 RET
GOT_KEY_5: MOV A, #05H
 RET
GOT_KEY_6: MOV A, #06H
 RET
GOT_KEY_7: MOV A, #07H
 RET
GOT_KEY_8: MOV A, #08H
 RET
GOT_KEY_9: MOV A, #09H
 RET
GOT_KEY_A: MOV A, #0AH
 RET
GOT_KEY_B: MOV A, #0BH
 RET
GOT_KEY_C: MOV A, #0CH
 RET
GOT_KEY_D: MOV A, #0DH
 RET
GOT_KEY_STAR: MOV A, #0EH
 RET
GOT_KEY_HASH: MOV A, #0FH
 RET

WAIT_KEY_RELEASE:
    MOV P1, #0F0H           
    MOV A, P1
    ANL A, #0F0H            
    CJNE A, #0F0H, WAIT_KEY_RELEASE 
    LCALL DEBOUNCE_DELAY
    RET

; ==============================================================================
; ACCUMULATE DECIMAL DIGIT & MATH SUBROUTINES
; ==============================================================================
ACCUMULATE_DIGIT:
    PUSH ACC                
    CJNE R7, #00H, ACC_OP2

    MOV A, R3               
    MOV B, #10
    MUL AB                  
    MOV R3, A
    MOV R0, B               

    MOV A, R2               
    MOV B, #10
    MUL AB                  
    ADD A, R0
    MOV R2, A               

    POP ACC                 
    ADD A, R3               
    MOV R3, A
    CLR A
    ADDC A, R2              
    MOV R2, A
    RET

ACC_OP2:
    MOV A, R5               
    MOV B, #10
    MUL AB                  
    MOV R5, A
    MOV R0, B               

    MOV A, R4               
    MOV B, #10
    MUL AB                  
    ADD A, R0
    MOV R4, A               

    POP ACC                 
    ADD A, R5               
    MOV R5, A
    CLR A
    ADDC A, R4              
    MOV R4, A
    RET

EXECUTE_MATH:
    MOV A, R6
    CJNE A, #01H, CHK_SUB
    LCALL MATH_ADD
    RET
CHK_SUB:
    CJNE A, #02H, CHK_MUL
    LCALL MATH_SUB
    RET
CHK_MUL:
    CJNE A, #03H, CHK_DIV
    LCALL MATH_MUL
    RET
CHK_DIV:
    CJNE A, #04H, CHK_AND
    LCALL MATH_DIV
    RET
CHK_AND:
    CJNE A, #05H, CHK_OR
    LCALL LOGIC_AND
    RET
CHK_OR:
    CJNE A, #06H, CHK_XOR
    LCALL LOGIC_OR
    RET
CHK_XOR:
    CJNE A, #07H, CHK_SQR
    LCALL LOGIC_XOR
    RET
CHK_SQR:
    CJNE A, #08H, MATH_DONE
    LCALL MATH_SQUARE
MATH_DONE:
    RET

MATH_ADD:
    MOV A, R3
    ADD A, R5
    MOV R3, A
    MOV A, R2
    ADDC A, R4
    MOV R2, A
    JC SET_MATH_ERROR        
    RET

MATH_SUB:
    CLR C
    MOV A, R3
    SUBB A, R5
    MOV R3, A
    MOV A, R2
    SUBB A, R4
    MOV R2, A
    JC SET_MATH_ERROR        
    RET

MATH_MUL:
    MOV A, R3
    MOV B, R5
    MUL AB                  
    MOV R3, A               
    MOV R2, B               
    RET

MATH_DIV:
    MOV A, R5
    JZ SET_MATH_ERROR        
    MOV A, R3
    MOV B, R5
    DIV AB
    MOV R3, A               
    MOV R2, #00H            
    RET

LOGIC_AND:
    MOV A, R3
    ANL A, R5
    MOV R3, A
    MOV R2, #00H
    CLR 20H.1               
    RET

LOGIC_OR:
    MOV A, R3
    ORL A, R5
    MOV R3, A
    MOV R2, #00H
    CLR 20H.1               
    RET

LOGIC_XOR:
    MOV A, R3
    XRL A, R5
    MOV R3, A
    MOV R2, #00H
    CLR 20H.1               
    RET

MATH_SQUARE:
    MOV A, R3
    MOV B, R3
    MUL AB
    MOV R3, A               
    MOV R2, B               
    CLR 20H.1               
    RET

SET_MATH_ERROR:
    SETB 20H.0              
    MOV R2, #0EEH           
    MOV R3, #0EEH           
    RET

    END
