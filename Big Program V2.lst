  864:	  048F	50 03		    JNC DIV16_NO_REM_OVER
  865:	  0491	75 42 01	    MOV DIV_OVER, #01H
  866:	  0494			DIV16_NO_REM_OVER:
  867:
  868:				    ; Make space for the next quotient bit.
