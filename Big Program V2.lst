  870:	  0495	E5 34		    MOV A, QUO_L
  871:	  0497	33		    RLC A
  872:	  0498	F5 34		    MOV QUO_L, A
  873:	  049A	E5 33		    MOV A, QUO_H
  874:	  049C	33		    RLC A
