  841:	  046C	75 34 00	    MOV QUO_L, #00H
  842:	  046F	75 35 00	    MOV REM_H, #00H
  843:	  0472	75 36 00	    MOV REM_L, #00H
  844:	  0475	78 10		    MOV R0, #16
  845:
  846:	  0477			DIV16_LOOP:
  847:				    ; Take the next dividend bit from the MSB side.
  848:	  0477	C3		    CLR C
  849:	  0478	E5 32		    MOV A, TMP_L
  850:	  047A	33		    RLC A
  851:	  047B	F5 32		    MOV TMP_L, A
  852:	  047D	E5 31		    MOV A, TMP_H
  853:	  047F	33		    RLC A
  854:	  0480	F5 31		    MOV TMP_H, A
  855:
  856:				    ; remainder = remainder*2 + next dividend bit.
  857:	  0482	E5 36		    MOV A, REM_L
  858:	  0484	33		    RLC A
  859:	  0485	F5 36		    MOV REM_L, A
  860:	  0487	E5 35		    MOV A, REM_H
  861:	  0489	33		    RLC A
