  104:	  0040			CHECK_DIGIT:
  105:				    ; CJNE sets C when A < 0AH. The target is the next instruction.
  106:	  0040	B4 0A 00	    CJNE A, #0AH, $ + 3
  107:	  0043	50 24		    JNC CHECK_OPERATOR
  108:
  109:				    ; A page-2 digit other than 4/6 is treated as a normal digit.
  110:	  0045	C2 01		    CLR 20H.1
  111:
  112:				    ; A digit entered after a displayed result starts a fresh calculation.
  113:				    ; Operators use PREPARE_ANS_EXPRESSION instead and preserve the result.
  114:	  0047	30 03 07	    JNB 20H.3, DIGIT_ENTRY_READY
  115:	  004A	C0 E0		    PUSH ACC
  116:	  004C	12 01 63	    LCALL START_NEW_ENTRY
  117:	  004F	D0 E0		    POP ACC
  118:	  0051			DIGIT_ENTRY_READY:
  119:
  120:				    ; Store first. If the 16-bit input overflows, do not echo the rejected digit.
  121:	  0051	C0 E0		    PUSH ACC
  122:	  0053	12 02 F1	    LCALL ACCUMULATE_DIGIT
  123:	  0056	D0 E0		    POP ACC
  124:	  0058	20 00 08	    JB 20H.0, DIGIT_ERROR
  125:
  126:	  005B	24 30		    ADD A, #30H
  127:	  005D	12 01 DD	    LCALL LCD_DATA
  128:	  0060	02 00 0F	    LJMP CALC_LOOP
  129:
  130:	  0063			DIGIT_ERROR:
