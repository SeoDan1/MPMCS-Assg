  313:	  019E			PREPARE_OPERATOR_ENTRY:
  314:				    ; If a result is already visible, start a calculation using that ANS.
  315:	  019E	20 00 15	    JB 20H.0, PREPARE_OPERATOR_DONE
  316:	  01A1	20 03 0B	    JB 20H.3, PREPARE_OPERATOR_USE_ANS
