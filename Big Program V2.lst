 Line  I  Addr  Code            Source

    1:				; ==============================================================================
    2:				; 8051 CALCULATOR - REQUIREMENT-COMPLETE VERSION 2
    3:				; Hardware: 4x4 keypad on P1, 16x2 HD44780-compatible LCD
    4:				; LCD data: P3.0-P3.7 | RS=P2.0 | RW=P2.1 | EN=P2.2
    5:				;
    6:				; KEYS
    7:				;   0..9       Decimal input
    8:				;   A/B/C/D    +, -, *, /
    9:				;   * then A   8-bit AND
   10:				;   * then B   8-bit OR
   11:				;   * then C   8-bit XOR
   12:				;   * then D   Select square; press # to calculate
   13:				;   #          Equals
   14:				;   * then #   Clear
   15:				;   * then 4   Manually scroll display left
   16:				;   * then 6   Manually scroll display right
   17:				;   *          Toggle next-page mode
   18:				;
   19:				; DISPLAY
   20:				;   Line 1: entered expression
   21:				;   Line 2: temporary READY, right-aligned signed result, or error message
   22:				;
   23:				; VALUES
   24:				;   R2:R3 = operand 1/result (high:low)
   25:				;   R4:R5 = operand 2        (high:low)
   26:				;   R6    = operator code
   27:				;   R7    = input state: 0=operand 1, 1=operand 2
   28:				;   20H.0 = error flag
   29:				;   20H.1 = next-page/shift flag
   30:				;   20H.2 = negative-result flag (R2:R3 stores the magnitude)
   31:				;   20H.3 = result-is-being-displayed flag
   32:				; ==============================================================================
   33:
   34:				; ----- Scratch RAM ------------------------------------------------------------
   35:		N      0030	DIGIT_TMP   EQU 30H             ; DIGIT TEMPORARY: most recently entered digit
   36:		N      0031	TMP_H       EQU 31H             ; TEMPORARY HIGH BYTE: high byte of working value
   37:		N      0032	TMP_L       EQU 32H             ; TEMPORARY LOW BYTE: low byte of working value
   38:		N      0033	QUO_H       EQU 33H             ; QUOTIENT HIGH BYTE: high byte of division quotient
   39:		N      0034	QUO_L       EQU 34H             ; QUOTIENT LOW BYTE: low byte of division quotient
   40:		N      0035	REM_H       EQU 35H             ; REMAINDER HIGH BYTE: high byte of division remainder
   41:		N      0036	REM_L       EQU 36H             ; REMAINDER LOW BYTE: low byte of division remainder
   42:		N      0037	MC0         EQU 37H             ; MULTIPLICAND BYTE 0: least-significant product byte
   43:		N      0038	MC1         EQU 38H             ; MULTIPLICAND BYTE 1

ASEM-51 V1.3                                         Copyright (c) 2002 by W.W. Heinz                                         PAGE 2



 Line  I  Addr  Code            Source

   44:		N      0039	MC2         EQU 39H             ; MULTIPLICAND BYTE 2
   45:		N      003A	MC3         EQU 3AH             ; MULTIPLICAND BYTE 3: most-significant product byte
   46:		N      003B	PROD0       EQU 3BH             ; PRODUCT BYTE 0: least-significant result byte
   47:		N      003C	PROD1       EQU 3CH             ; PRODUCT BYTE 1
   48:		N      003D	PROD2       EQU 3DH             ; PRODUCT BYTE 2: nonzero means 16-bit overflow
   49:		N      003E	PROD3       EQU 3EH             ; PRODUCT BYTE 3: most-significant result byte
   50:		N      003F	MUL0        EQU 3FH             ; MULTIPLIER LOW BYTE: low byte of second factor
   51:		N      0040	MUL1        EQU 40H             ; MULTIPLIER HIGH BYTE: high byte of second factor
   52:		N      0041	ERROR_CODE  EQU 41H             ; ERROR CODE: selects the LCD error message
   53:		N      0042	DIV_OVER    EQU 42H             ; DIVISION OVERFLOW BIT: temporary 17th remainder bit
   54:		N      0043	DIGIT_COUNT EQU 43H             ; DIGIT COUNT: decimal characters awaiting display
   55:
   56:				; Error codes
   57:				; 01H = overflow, 03H = divide by zero
   58:				; 04H = input greater than 65535
   59:				; 06H = logical operation requested with a negative ANS
   60:
   61:		N      0000	    ORG 0000H
   62:	  0000	02 00 03	    LJMP MAIN
   63:
   64:				; ==============================================================================
   65:				; INITIALISATION AND MAIN CONTROLLER
   66:				; ==============================================================================
   67:	  0003			MAIN:
   68:	  0003	75 81 5F	    MOV SP, #5FH                 ; Stack uses 60H upward, away from variables
   69:	  0006	75 90 FF	    MOV P1, #0FFH
   70:	  0009	12 01 B7	    LCALL LCD_INIT
   71:	  000C	12 01 30	    LCALL CLEAR_ALL
   72:
   73:	  000F			CALC_LOOP:
   74:	  000F	12 02 46	    LCALL KEYPAD_SCAN
   75:	  0012	B4 FF 03	    CJNE A, #0FFH, PROCESS_KEY
   76:	  0015	02 00 0F	    LJMP CALC_LOOP
   77:
   78:	  0018			PROCESS_KEY:
   79:	  0018	C0 E0		    PUSH ACC
   80:	  001A	12 02 DA	    LCALL WAIT_KEY_RELEASE
   81:	  001D	D0 E0		    POP ACC
   82:
   83:				    ; * toggles the next-page/shifted keypad layer.
   84:	  001F	B4 0E 05	    CJNE A, #0EH, CHECK_SHIFTED_DIGIT
   85:	  0022	B2 01		    CPL 20H.1
   86:	  0024	02 00 0F	    LJMP CALC_LOOP
   87:
   88:	  0027			CHECK_SHIFTED_DIGIT:
   89:	  0027	30 01 16	    JNB 20H.1, CHECK_DIGIT
   90:
   91:				    ; Page 2 + 4: scroll the entire LCD display left.
   92:	  002A	B4 04 08	    CJNE A, #04H, TRY_SCROLL_RIGHT
   93:	  002D	C2 01		    CLR 20H.1
   94:	  002F	12 02 0D	    LCALL LCD_SCROLL_LEFT
   95:	  0032	02 00 0F	    LJMP CALC_LOOP
   96:
   97:	  0035			TRY_SCROLL_RIGHT:
   98:				    ; Page 2 + 6: scroll the entire LCD display right.
   99:	  0035	B4 06 08	    CJNE A, #06H, CHECK_DIGIT

