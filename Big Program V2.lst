  295:	  0180			PREPARE_ANS_EXPRESSION:
  296:				    ; An operator entered after a result starts a chained calculation.
  297:				    ; Preserve R2:R3 and the sign, clear operand 2, and show "ANS" on line 1.
  298:	  0180	30 03 1A	    JNB 20H.3, PREPARE_ANS_DONE
  299:	  0183	7C 00		    MOV R4, #00H
  300:	  0185	7D 00		    MOV R5, #00H
